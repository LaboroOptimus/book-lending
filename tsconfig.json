{
  "compilerOptions": {
    "module": "Node16", "moduleResolution": "Node16", "declaration": true, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "target": "ES2022", "sourceMap": true,
    "outDir": "./dist", "baseUrl": "./", "incremental": true, "isolatedModules": true,
    "strict": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
