# Local Docker PostgreSQL. Replace with a Neon connection string in production.
DATABASE_URL="postgresql://book_lending:book_lending@localhost:5432/book_lending?schema=public"
PORT=3000
NODE_ENV=development
# Use independent random strings with 32+ characters. Never commit production values.
SESSION_SECRET="replace-with-a-long-random-session-secret"
CSRF_SECRET="replace-with-a-different-long-random-csrf-secret"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Required only by `npm run seed`; use different non-committed demo passwords.
SEED_ADMIN_PASSWORD="replace-with-admin-demo-password"
SEED_LIBRARIAN_PASSWORD="replace-with-librarian-demo-password"
